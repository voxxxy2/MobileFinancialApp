# Expo App Environment Variables
# Copy this file to .env and fill in your backend URL

# Backend API URL
# For Android emulator, use 10.0.2.2 instead of localhost
# For physical Android device, use your computer's local IP (e.g. http://192.168.1.100:5000/api)
# For Windows desktop, localhost works fine
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
