# FinTrack Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Connection
# Option 1: Use a connection string (Supabase, Railway, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/fintrack

# Option 2: Individual fields (uncomment if not using DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=fintrack
# DB_USER=postgres
# DB_PASSWORD=password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Exchange Rate API (free, no key needed for basic use)
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest

# Alpha Vantage (free stock prices — get key at alphavantage.co)
ALPHA_VANTAGE_KEY=demo

# CoinGecko (free crypto prices, no key needed)
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# CORS — set to your frontend origin in production
CORS_ORIGIN=*
